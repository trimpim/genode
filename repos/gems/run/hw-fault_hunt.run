							<inline name="pubkey">}   [depot_user_pubkey   alex-ab] {</inline>
						</dir>
					</dir>
					<dir name="public"> <ram/> </dir>
				</vfs>
				<policy label="depot_download -> depot"  root="/depot"  writeable="yes"/>
				<policy label="depot_download -> public" root="/public" writeable="yes"/>
			</config>
			<route>
				<any-service> <parent/> </any-service>
			</route>
		</start>

		<start name="depot_download" pkg="} [depot_user] {/pkg/} [current_pkg depot_download_runtime] {">
			<heartbeat/>
			<route>
				<service name="File_system"> <child name="vfs"/> </service>
				<service name="ROM" label_last="installation"> <parent label="installation"/> </service>
				<any-service> <parent/> </any-service>
			</route>
		</start>

		<start name="pd_fault-3" pkg="} [depot_user] {/pkg/} [current_pkg test-pd_fault] {">
			<config wait_time="456">
				<vfs> <fs/> </vfs>
			</config>
			<heartbeat/>
			<monitor_cpu_faults/>
			<monitor_pd_faults/>
		</start>
-->
	</config>}

append deploy_2_data {	<config arch="} [arch] {">

		} $deploy_common {

		<start name="test-log" pkg="} [depot_user] {/pkg/} [current_pkg test-log] {">
			<heartbeat/>
			<route>
				<service name="File_system"> <child name="vfs"/> </service>
				<service name="ROM" label_last="installation"> <parent label="installation"/> </service>
				<any-service> <parent/> </any-service>
			</route>
		</start>
<!--
		<start name="pd_fault-2" pkg="} [depot_user] {/pkg/} [current_pkg test-pd_fault] {">
			<config wait_time="233">
				<vfs> <fs/> </vfs>
			</config>
			<heartbeat/>
			<monitor_cpu_faults/>
			<monitor_pd_faults/>
		</start>
-->
	</config>}

write_deploy deploy_1 $deploy_1_data
write_deploy deploy_2 $deploy_2_data

# create simple system state ROM for imx8mp devices
set fd [open [run_dir]/genode/system w]
puts $fd { <system state=""/> }
close $fd

build_boot_image [list {*}[build_artifacts] deploy_1 deploy_2]

append qemu_args " -nographic "
append_qemu_nic_args


run_genode_until forever
